{
  "name": "yingzhou-zhagang-mahjong",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "typecheck": "vue-tsc --noEmit",
    "build": "python scripts/android-release.py",
    "build:web": "npm run typecheck && vite build",
    "build:edgeone": "node scripts/edgeone-release.mjs build",
    "android:signing-init": "python scripts/android-release.py --init-signing",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:yaotong": "vitest run src/game/variants/yaotong",
    "test:yingzhou": "vitest run src/game/variants/yingzhou",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "fflate": "0.8.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
